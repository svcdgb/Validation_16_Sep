	column Column = LOOKUPVALUE(fact_sales_order[ORDER_PLACED_DT],fact_sales_order[ORDER_PLACED_DT],'Dim DateTime'[Date])
		formatString: General Date
		lineageTag: 3453efec-5955-4f77-9b78-0d74960d5daf
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Month Name' = FORMAT('Dim DateTime'[Date],"Mmm-YY")
		lineageTag: 56a6e23c-3a01-4547-aa88-0c224a571e75
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Dim DateTime' = calculated
		mode: import
		source =
				
				VAR MinDateTime =
				    MINX(
				        fact_sales_order,
				        fact_sales_order[ORDER_PLACED_TIMESTAMP]
				    )
				
				VAR MaxDateTime =
				TODAY() + TIME(23, 0, 0)
				
				RETURN
				ADDCOLUMNS(
				    GENERATE(
				        CALENDAR(
				            DATEVALUE(MinDateTime),
				            DATEVALUE(MaxDateTime)
				        ),
				        VAR CurrentDate = [Date]
				        RETURN
				            FILTER(
				                ADDCOLUMNS(
				                    GENERATESERIES(0, 23, 1),
				                    "Hour", [Value],
				                    "DateTime", CurrentDate + TIME([Value], 0, 0)
				                ),
				                CurrentDate + TIME([Value], 0, 0) <= MaxDateTime
				            )
				    ),
				
				    // ✅ Formatting & labels
				
				    "Hour Label", FORMAT([Hour], "00") & ":00"
				)

	annotation PBI_Id = 443bd950ee014f688110d87cd795ba20

