	column NewDate =
			
			VAR MaxDate =
			    CALCULATE(
			        MAX('Dim DateTime'[Date]),
			        ALL('Dim DateTime')
			    )
			RETURN
			IF(
			    'Dim DateTime'[Date] = MaxDate,
			    "Today's Date",
			    FORMAT('Dim DateTime'[Date], "MM/dd/yyyy")
			)
		lineageTag: e0bfa15e-3949-421d-899a-b009c756a7e6
		summarizeBy: none
		sortByColumn: Date

		annotation SummarizationSetBy = Automatic

