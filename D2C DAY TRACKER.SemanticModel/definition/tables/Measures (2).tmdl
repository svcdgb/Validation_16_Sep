	measure 'Ind NS D-1 %' =
			
			VAR Ind_NS = [Ind NS]
			VAR Ind_NS_D_1 = [Ind NS D-1]
			
			VAR _perc =
			    DIVIDE(Ind_NS - Ind_NS_D_1, Ind_NS_D_1)
			
			
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_perc), BLANK(),
			    _perc
			)
		formatString: 0%;-0%;0%
		displayFolder: D-1
		lineageTag: 7092d286-d729-479e-adb7-05266b081515

	measure 'Ind NS D-1 Color' =
			
			VAR _perc =
			    DIVIDE([Ind NS] - [Ind NS D-1], [Ind NS D-1])
			RETURN
			SWITCH(
			    TRUE(),
			    _perc > 0, "#008000",   -- Green ✅
			    _perc < 0, "#FF0000",   -- Red ✅
			    "#000000"
			)
		displayFolder: D-1
		lineageTag: 55155dac-ca52-414a-9876-7ac2b1d351e2

