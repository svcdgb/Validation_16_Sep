	measure 'Max Date' =
			
			VAR MaxDate =
			    CALCULATE(MAX(fact_sales_order[ORDER_HOUR]) + + TIME(1, 0, 0),ALL('Dim DateTime'),ALL(Dim_Country))
			RETURN
			"Data reflects performance up to "
			    & FORMAT(MaxDate, "dd-MMM-yyyy hh:mm AM/PM")
			    & " CEST"
		lineageTag: 77c2214b-55a9-4626-bc5b-2e9492920437

	measure MAX_DATE =
			
			CALCULATE( MAX(fact_sales_order[ORDER_PLACED_TIMESTAMP]),ALL(fact_sales_order))
		formatString: General Date
		lineageTag: 686d543c-8539-4061-8bbe-0d2a1af0d2a6

	measure 'PY Ind NS' = ```
			
			VAR CurrentDate = MAX('Dim DateTime'[Date])
			VAR CurrentHour = SELECTEDVALUE('Dim DateTime'[Hour])
			
			VAR Final =
			IF(
			    HASONEVALUE('Dim DateTime'[Hour]),
			    
			    -- ✅ Row level (hour exists)
			    COALESCE(
			        CALCULATE(
			            [Ind NS],
			            FILTER(
			                ALL('Dim DateTime'),
			                'Dim DateTime'[Date] = CurrentDate - 364 &&
			                'Dim DateTime'[Hour] = CurrentHour
			            )
			        ),
			        0
			    ),
			
			    -- ✅ Total level (no single hour → sum all hours)
			    COALESCE(
			        CALCULATE(
			            [Ind NS],
			            FILTER(
			                ALL('Dim DateTime'),
			                'Dim DateTime'[Date] = CurrentDate - 364
			            )
			        ),
			        0
			    )
			)
			
			RETURN IF(ISBLANK(Final),0,Final)
			```
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 5bfd8bb4-cf2e-459b-9a89-7b3bc6150da8

