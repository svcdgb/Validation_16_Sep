table 'Measures (2)'
	lineageTag: d60743ad-daa8-4a2b-a8cb-ff6f8c662149

	measure 'Ind NS' = CALCULATE(SUM(fact_sales_order[NET_SALES_ORDER_AMT_EUR]))
		formatString: "€"\ #,0;-"€"\ #,0;"€"\ #,0
		lineageTag: 590d07c8-8b32-47a8-b1bb-1e6bec38a2d4

	measure 'No of Order -1' =
			
			// CALCULATE(DISTINCTCOUNT(fact_sales_order[ORDER_NO]))
			
			VAR MaxDataDate =
			    MAXX(
			        FILTER(
			            ALL('Dim DateTime'),
			            NOT ISBLANK([Ind NS])
			        ),
			        INT('Dim DateTime'[DateTime])
			    )
			
			VAR MaxHourWithData =
			    MAXX(
			        FILTER(
			            ALL('Dim DateTime'),
			            INT('Dim DateTime'[DateTime]) = MaxDataDate
			                && NOT ISBLANK([Ind NS])
			        ),
			        'Dim DateTime'[DateTime]
			    )
			
			RETURN
			SUMX(
			    VALUES('Dim DateTime'[DateTime]),
			    VAR CurrentDateTime = 'Dim DateTime'[DateTime]
			    RETURN
			        IF(
			            CurrentDateTime <= MaxHourWithData,
			            CALCULATE(
			                DISTINCTCOUNT(fact_sales_order[ORDER_NO]),
			                'Dim DateTime'[DateTime] = CurrentDateTime - TIME(1,0,0)
			            )
			        )
			)
		formatString: #,0
		lineageTag: 7c1b9700-501d-43d6-97b7-72b0882127ee

